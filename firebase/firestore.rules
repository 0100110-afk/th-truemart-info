rules_version = '2';
// Quyền truy cập app TH true mart.
// - Danh sách người dùng nằm ở users/<email> (Sync.gs ghi từ sheet "APP USERS"; app KHÔNG ghi được).
// - Dữ liệu bảng (meta, sheetdata) chỉ Sync.gs ghi bằng service account (bỏ qua rules) -> app chỉ đọc.
// - Kho vật tư: viewer chỉ đọc, editor/admin được ghi.
// - Bắt buộc EMAIL ĐÃ XÁC MINH: Google luôn xác minh; tài khoản mật khẩu do Sync.gs tạo được
//   đánh dấu xác minh. Ai tự đăng ký bằng SDK với email của người trong danh sách -> bị chặn.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function profile() { return get(/databases/$(database)/documents/users/$(email())); }
    function member() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/users/$(email()));
    }
    function editor() { return member() && profile().data.role in ['editor', 'admin']; }

    match /users/{id} {
      allow get: if request.auth != null && request.auth.token.email != null && id == email();
      allow list, write: if false;
    }
    match /meta/{id}          { allow read: if member(); allow write: if false; }
    match /sheetdata/{id}     { allow read: if member(); allow write: if false; }
    match /vattu/{id}         { allow read: if member(); allow write: if editor(); }
    match /vattu_autolog/{id} { allow read: if member(); allow write: if editor(); }
  }
}
